{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neseggi",
  "compatibility_date": "2026-07-10",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "NESEGGI_DB",
      "database_name": "neseggi-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_ID",
      "preview_database_id": "REPLACE_WITH_STAGING_D1_PREVIEW_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NESEGGI_KV",
      "id": "REPLACE_WITH_STAGING_KV_ID",
      "preview_id": "REPLACE_WITH_STAGING_KV_PREVIEW_ID"
    }
  ],
  "vars": {
    "GA4_MEASUREMENT_ID": "REPLACE_WITH_GA4_ID"
  }
}
